[Unit]
Description=MonitoringLinux remote service dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/monitoring-linux --config /etc/monitoring-linux/monitoring.conf
WorkingDirectory=/opt/monitoring-linux
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

